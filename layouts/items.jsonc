{
  // sets layouts for shadred items grids
  // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
  "shared_item_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "4, 4",
            "h_alignment": "left",
            "item_size": "4",
            "rows": [
              [
                "short",
                "middle",
                "long",
                "approach",
                "power",
                "wedges",
                "irons",
                "woods"
              ],
              [
                "peach",
                "maple",
                "metalmario",
                "goldtrophies"
              ],
              [
                "toadtournament",
                "koopacup",
                "shyguyinternational",
                "yoshichampionship",
                "booclassic",
                "marioopen"
              ],
              [
                "toadhighlands",
                "koopapark",
                "shyguydesert",
                "yoshisisland",
                "boovalley",
                "mariosstar"
              ]
            ]
          }
        ]
      }
    ]
  }
}
